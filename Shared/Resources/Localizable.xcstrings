    "app.about": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsão local com Apple Weather. Sua localização é usada apenas para obter o clima e fica armazenada no aparelho para atualizar os widgets."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local forecasts with Apple Weather. Your location is used only to fetch weather and is stored on your device for widget updates."
          }
        }
      }
    },
